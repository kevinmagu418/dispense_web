# ---------------------------------------------------------------------------
# Dispense marketing website — environment configuration
# Copy to .env.local and fill in. Nothing here is a backend secret: this site
# never talks to the Spring Boot services directly.
# ---------------------------------------------------------------------------

# Absolute origin of the deployed site. Used for canonicals, the sitemap,
# robots.txt, Open Graph image URLs and the download QR code.
# Replace the placeholder before launch — until it is set, every canonical and
# OG URL points at https://dispense.example.
NEXT_PUBLIC_SITE_URL=

# App store listings. Leave empty until the listings exist — the download page
# then shows the waitlist state instead of a dead link.
NEXT_PUBLIC_ANDROID_DOWNLOAD_URL=
NEXT_PUBLIC_IOS_DOWNLOAD_URL=

# Support inbox shown in the footer, FAQ, download and legal pages.
# Defaults to support@dispense.example when empty.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Analytics measurement id (gtag-compatible). Analytics stays completely off
# while this is empty: no script is loaded and no events leave the browser.
# Even with an id set, nothing is measured until a visitor grants analytics
# consent — see lib/consent.ts and lib/analytics.ts.
NEXT_PUBLIC_ANALYTICS_ID=

# Optional hosted product video (YouTube/Vimeo embed URL). Leave empty to use the
# native HTML5 file at public/media/dispense-demo.mp4, or neither while the demo
# is still being produced.
NEXT_PUBLIC_DEMO_EMBED_URL=
